---
import Base from './Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: object;
  breadcrumbLabel: string;
  updatedDate?: string;
  publishDate?: string;
}

const { title, description, canonical, ogImage, ogType = 'article', jsonLd, breadcrumbLabel, updatedDate, publishDate } = Astro.props;
---

<Base title={`${title} — ISMR`} description={description} canonical={canonical} ogImage={ogImage} ogType={ogType} jsonLd={jsonLd}>
  {updatedDate && <meta slot="head" property="article:modified_time" content={updatedDate} />}
  {publishDate && <meta slot="head" property="article:published_time" content={publishDate} />}
  <Navbar activePage="diagnostics" />

  <section class="page-hero">
    <div class="page-hero-inner">
      <div class="breadcrumb" style="padding: 0 0 1rem; margin: 0;">
        <a href="/">ISMR Home</a><span>›</span><a href="/diagnostics/">Diagnostics</a><span>›</span>{breadcrumbLabel}
      </div>
      <h1>{title}</h1>
    </div>
  </section>

  <main data-pagefind-body class="guide-content">
    <slot />
  </main>

  <Footer updatedDate={updatedDate} />
</Base>
