---
import { getCollection, render } from 'astro:content';
import Diagnostic from '../../layouts/Diagnostic.astro';

export async function getStaticPaths() {
  const guides = await getCollection('diagnostics', ({ data }) => !data.draft);
  return guides.map(guide => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const { title, description, canonical, updatedDate } = guide.data;
---

<Diagnostic
  title={title}
  description={description}
  canonical={canonical}
  breadcrumbLabel={title}
  updatedDate={updatedDate.toISOString().slice(0, 10)}
>
  <Content />
</Diagnostic>
