---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';

const title = "Diagnostics — ISMR";
const description = "Interactive diagnostic tools for GY6 and Piaggio/Vespa scooters — no-start troubleshooting, carburetor issues, CVT noise, EFI fault codes, and more.";
const canonical = "https://ismr.online/diagnostics/";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Diagnostics — ISMR",
  "description": description,
  "url": canonical,
  "isPartOf": { "@type": "WebSite", "name": "ISMR", "url": "https://ismr.online/" }
};
---

<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <style is:global>
    .page-hero { background: linear-gradient(135deg, var(--bg-dark) 0%, var(--surface) 60%, var(--bg-dark) 100%); padding: 4rem 2rem 3rem; position: relative; overflow: hidden; border-bottom: 1px solid var(--border); }
    .page-hero::before { content: "🔍"; position: absolute; right: 6%; top: 50%; transform: translateY(-50%); font-size: 9rem; opacity: 0.07; pointer-events: none; line-height: 1; }
    .page-hero-inner { max-width: 1100px; margin: 0 auto; }
    .page-hero h1 { font-size: clamp(2rem, 5vw, 3.2rem); background: linear-gradient(135deg, var(--text-primary), var(--accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 0.75rem; }
    .page-hero p { color: var(--text-secondary); font-size: 1.05rem; max-width: 620px; margin-bottom: 1.5rem; }
    .page-hero-stats { display: flex; gap: 2rem; flex-wrap: wrap; }
    .hero-stat { display: flex; flex-direction: column; gap: 0.15rem; }
    .hero-stat-number { font-size: 1.6rem; font-weight: 700; color: var(--primary); line-height: 1; }
    .hero-stat-label { font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
    .guides-section { padding: 3rem 2rem 5rem; }
    .guides-section-inner { max-width: 1100px; margin: 0 auto; }
    .guides-count { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1.5rem; }
    .guides-count strong { color: var(--text-primary); }
    .section-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-tertiary); margin: 2.5rem 0 1rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--border); }
    .section-label:first-child { margin-top: 0; }
    .filters-bar { background: var(--surface); border-bottom: 1px solid var(--border); padding: 0 2rem; position: sticky; top: 64px; z-index: 90; }
    .filters-inner { max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; gap: 0.4rem; padding: 0.65rem 0; }
    .filter-row { display: flex; align-items: center; gap: 0.25rem; flex-wrap: wrap; }
    .filter-label { font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-right: 0.1rem; white-space: nowrap; }
    .filter-btn { background: transparent; border: 1px solid var(--border); color: var(--text-muted); padding: 0.4rem 1rem; border-radius: var(--radius-pill); font-size: 0.85rem; font-weight: 500; cursor: pointer; transition: var(--transition); white-space: nowrap; }
    .filter-btn:hover { border-color: var(--accent); color: var(--accent); }
    .filter-btn.active { background: var(--primary); border-color: var(--primary); color: var(--bg-light); }
    .filter-divider { display: inline-block; width: 1px; height: 1.2rem; background: var(--border); margin: 0 0.25rem; flex-shrink: 0; }
    .filters-search { margin-left: auto; background: var(--surface-2); border: 1px solid var(--border); color: var(--text-primary); padding: 0.35rem 0.85rem; border-radius: var(--radius-pill); font-size: 0.85rem; outline: none; min-width: 190px; transition: var(--transition); flex-shrink: 0; }
    .filters-search::placeholder { color: var(--text-muted); }
    .filters-search:focus { border-color: var(--accent); box-shadow: var(--shadow-sm); }
    .guide-card.hidden { display: none; }
    .no-results { grid-column: 1 / -1; text-align: center; padding: 4rem 2rem; color: var(--text-muted); display: none; }
    .no-results.visible { display: block; }
    @media (max-width: 768px) {
      .filters-bar { padding: 0 1rem; top: 56px; }
      .filter-btn { padding: 0.35rem 0.7rem; font-size: 0.78rem; }
      .filter-label { font-size: 0.7rem; }
      .page-hero { padding: 2.5rem 1rem 2rem; }
      .page-hero h1 { font-size: 1.8rem; }
      .page-hero-stats { gap: 1.2rem; }
    }
    @media (max-width: 480px) {
      .page-hero h1 { font-size: 1.4rem; }
      .page-hero { padding: 2rem 1rem 1.5rem; }
      .hero-stat-number { font-size: 1.2rem; }
    }
  </style>

  <Navbar activePage="diagnostics" />

  <main data-pagefind-body role="main">
    <section class="page-hero">
      <div class="page-hero-inner">
        <div class="breadcrumb" style="padding: 0 0 1rem; margin: 0;">
          <a href="/">ISMR Home</a><span>›</span>Diagnostics
        </div>
        <h1>Diagnostics</h1>
        <p>Fault codes, error symptoms, and troubleshooting trees for carbureted and EFI petrol scooters. Start with a symptom, end with a fix.</p>
        <div class="page-hero-stats">
          <div class="hero-stat"><span class="hero-stat-number">15</span><span class="hero-stat-label">Guides</span></div>
          <div class="hero-stat"><span class="hero-stat-number">Carb + EFI</span><span class="hero-stat-label">Coverage</span></div>
          <div class="hero-stat"><span class="hero-stat-number">Free</span><span class="hero-stat-label">Always</span></div>
        </div>
      </div>
    </section>

    <div class="filters-bar">
      <div class="filters-inner">
        <div class="filter-row">
          <button class="filter-btn active" data-filter-type="category" data-filter="all">All</button>
          <button class="filter-btn" data-filter-type="category" data-filter="starting">🚫 Won't Start</button>
          <button class="filter-btn" data-filter-type="category" data-filter="fuel">⛽ Fuel &amp; Idle</button>
          <button class="filter-btn" data-filter-type="category" data-filter="transmission">⚙️ Transmission</button>
          <button class="filter-btn" data-filter-type="category" data-filter="electrical">⚡ Electrical</button>
          <input type="search" class="filters-search" id="diagSearch" placeholder="Search diagnostics…" aria-label="Search diagnostic guides">
        </div>
        <div class="filter-row">
          <span class="filter-label">Engine:</span>
          <button class="filter-btn" data-filter-type="engine" data-filter="gy6">GY6</button>
          <button class="filter-btn" data-filter-type="engine" data-filter="piaggio">Piaggio / Vespa</button>
          <span class="filter-divider" aria-hidden="true"></span>
          <span class="filter-label">Fuel:</span>
          <button class="filter-btn" data-filter-type="fuel" data-filter="carb">Carb</button>
          <button class="filter-btn" data-filter-type="fuel" data-filter="efi">EFI</button>
        </div>
      </div>
    </div>

    <section style="padding: 1.5rem 2rem 0;">
      <div style="max-width: 1100px; margin: 0 auto;">
        <a href="/diagnostics/wizard.html" style="
          display: flex; align-items: center; justify-content: space-between; gap: 1rem;
          background: linear-gradient(135deg, rgba(255,107,53,0.12), rgba(0,168,204,0.1));
          border: 1px solid rgba(255,107,53,0.35);
          border-radius: 12px;
          padding: 1.2rem 1.6rem;
          text-decoration: none;
          transition: all 0.3s ease;
        " onmouseover="this.style.borderColor='rgba(255,107,53,0.7)'; this.style.transform='translateY(-1px)';"
           onmouseout="this.style.borderColor='rgba(255,107,53,0.35)'; this.style.transform='';">
          <div style="display:flex; align-items:center; gap:1rem;">
            <span style="font-size:2rem; line-height:1;">🔍</span>
            <div>
              <div style="font-weight:700; font-size:1rem; color:var(--text-primary);">Not sure where to start? Try the Diagnosis Wizard</div>
              <div style="font-size:0.85rem; color:var(--text-secondary); margin-top:0.15rem;">Answer a few questions and we'll point you to the likely fault.</div>
            </div>
          </div>
          <span style="color:var(--primary); font-size:1.4rem; flex-shrink:0;">→</span>
        </a>
      </div>
    </section>

    <section class="guides-section">
      <div class="guides-section-inner">
        <p class="guides-count"><strong id="visibleCount">15</strong> diagnostic guides</p>

        <div class="section-label">Piaggio ZIP 50/100 4T</div>
        <div class="guides-grid">
          <article class="guide-card" data-category="starting" data-engine="piaggio" data-fuel="carb">
            <div class="card-guide-tag">Piaggio · Official</div>
            <h3><a href="/diagnostics/piaggio-zip-100-troubleshooting.html">Piaggio ZIP 50/100 4T — Full Troubleshooting Guide</a></h3>
            <p>Official Piaggio service manual fault diagnosis: won't start, poor performance, excessive fuel consumption, clutch faults, CVT issues, and quick-reference symptom table.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">Won't Start</span>
              <span class="guide-guide-tag">CVT</span>
              <span class="guide-guide-tag">Carburetor</span>
              <span class="time">Reference</span>
            </div>
            <a href="/diagnostics/piaggio-zip-100-troubleshooting.html" class="read-more">Read Guide</a>
          </article>
        </div>

        <div class="section-label">Won't Start</div>
        <div class="guides-grid">
          <article class="guide-card" data-category="starting" data-engine="gy6" data-fuel="both">
            <div class="card-guide-tag">GY6</div>
            <h3><a href="/diagnostics/gy6-no-start-troubleshooting.html">Scooter Won't Start — Troubleshooting Checklist</a></h3>
            <p>Systematic checklist for diagnosing a GY6 scooter that cranks but won't fire: spark, fuel, compression, and electrics.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">Carburetor</span>
              <span class="guide-guide-tag">Ignition</span>
              <span class="time">20 min</span>
            </div>
            <a href="/diagnostics/gy6-no-start-troubleshooting.html" class="read-more">Read Guide</a>
          </article>

          <article class="guide-card" data-category="starting" data-engine="gy6" data-fuel="both">
            <div class="card-guide-tag">GY6</div>
            <h3><a href="/diagnostics/gy6-side-stand-kill-switch.html">Side Stand Kill Switch — No-Start Diagnosis</a></h3>
            <p>How to test and diagnose a faulty side stand inhibitor switch that prevents the engine from starting, including bypass test and replacement.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">Electrical</span>
              <span class="guide-guide-tag">Kill Switch</span>
              <span class="time">15 min</span>
            </div>
            <a href="/diagnostics/gy6-side-stand-kill-switch.html" class="read-more">Read Guide</a>
          </article>

          <article class="guide-card" data-category="starting" data-engine="both" data-fuel="both">
            <div class="card-guide-tag">GY6 · Piaggio</div>
            <h3><a href="/diagnostics/gy6-dirty-buttons-no-start.html">Dirty Handlebar Buttons — No-Start Diagnosis &amp; Fix</a></h3>
            <p>Kill switch and starter button corrosion are a frequent cause of electrical no-start on older scooters. How to test, clean, and replace.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">Electrical</span>
              <span class="guide-guide-tag">Buttons</span>
              <span class="time">20 min</span>
            </div>
            <a href="/diagnostics/gy6-dirty-buttons-no-start.html" class="read-more">Read Guide</a>
          </article>
        </div>

        <div class="section-label">Fuel System &amp; Idle</div>
        <div class="guides-grid">
          <article class="guide-card" data-category="fuel" data-engine="both" data-fuel="carb">
            <div class="card-guide-tag">GY6 · Piaggio</div>
            <h3><a href="/diagnostics/carburetor-needle-height-diagnostics.html">Carburetor Needle Height Diagnostics</a></h3>
            <p>Identify whether a rich or lean needle position is causing mid-throttle hesitation, surging, or black smoke. Includes spark plug reading guide and symptom flowchart.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">Carburetor</span>
              <span class="guide-guide-tag">Mid-Throttle</span>
              <span class="time">20 min</span>
            </div>
            <a href="/diagnostics/carburetor-needle-height-diagnostics.html" class="read-more">Read Guide</a>
          </article>

          <article class="guide-card" data-category="fuel" data-engine="gy6" data-fuel="efi">
            <div class="card-guide-tag">GY6 · EFI</div>
            <h3><a href="/diagnostics/gy6-efi-fuel-injection-troubleshooting.html">EFI Fuel Injection Troubleshooting</a></h3>
            <p>Systematic fault diagnosis for GY6 EFI systems: fuel pump, injector, TPS, MAP, CTS, ECU fault blink codes, and ground wiring.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">Fuel Injection</span>
              <span class="guide-guide-tag">EFI</span>
              <span class="time">30 min</span>
            </div>
            <a href="/diagnostics/gy6-efi-fuel-injection-troubleshooting.html" class="read-more">Read Guide</a>
          </article>

          <article class="guide-card" data-category="fuel" data-engine="gy6" data-fuel="efi">
            <div class="card-guide-tag">GY6 · EFI</div>
            <h3><a href="/diagnostics/gy6-efi-cel-flash-codes.html">EFI CEL Flash Codes — Manual Diagnostic Mode</a></h3>
            <p>How to enter manual diagnostic mode on GY6 EFI scooters and read flash code sequences. Full code reference table with causes and severity.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">EFI</span>
              <span class="guide-guide-tag">Fault Codes</span>
              <span class="guide-guide-tag">CEL</span>
              <span class="time">15 min</span>
            </div>
            <a href="/diagnostics/gy6-efi-cel-flash-codes.html" class="read-more">Read Guide</a>
          </article>

          <article class="guide-card" data-category="fuel" data-engine="gy6" data-fuel="efi">
            <div class="card-guide-tag">GY6 · EFI · Euro 4/5</div>
            <h3><a href="/diagnostics/gy6-efi-obd2-dtc-fault-codes.html">EFI OBD-2 DTC Fault Codes — Rongmao / Delphi / Motion</a></h3>
            <p>Complete P-code reference and step-by-step diagnostic procedures for GY6 scooters with Rongmao, Delphi, or Motion EFI systems. Includes symptom-based flows for won't start, hard start, unstable idle, and more.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">EFI</span>
              <span class="guide-guide-tag">OBD-2 / DTC</span>
              <span class="guide-guide-tag">Rongmao</span>
              <span class="time">Reference</span>
            </div>
            <a href="/diagnostics/gy6-efi-obd2-dtc-fault-codes.html" class="read-more">Read Guide</a>
          </article>

          <article class="guide-card" data-category="fuel" data-engine="gy6" data-fuel="efi">
            <div class="card-guide-tag">GY6 · EFI · Advanced</div>
            <h3><a href="/diagnostics/gy6-efi-hud-ecu-hacker-setup.html">HUD ECU Hacker Setup Guide</a></h3>
            <p>Step-by-step guide to set up HUD ECU Hacker on Windows, install FTDI drivers, and connect to a GY6 EFI scooter via OBD2 KKL cable to read live data and fault codes.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">EFI</span>
              <span class="guide-guide-tag">OBD2</span>
              <span class="guide-guide-tag">ECU Software</span>
              <span class="time">45 min</span>
            </div>
            <a href="/diagnostics/gy6-efi-hud-ecu-hacker-setup.html" class="read-more">Read Guide</a>
          </article>

          <article class="guide-card" data-category="fuel" data-engine="both" data-fuel="efi">
            <div class="card-guide-tag">GY6 · Piaggio · EFI</div>
            <h3><a href="/diagnostics/ecu-hud-hacker-live-data-guide">ECU Live Data with HUD Hacker — Field Reference</a></h3>
            <p>Every live data field in HUD Hacker's Data Grid explained — RPM, fuel trims, MAP, TPS, O2 voltage, MIL distance, and more. Normal value ranges at idle and under load, plus 5 common fault patterns.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">EFI</span>
              <span class="guide-guide-tag">OBD2</span>
              <span class="guide-guide-tag">Live Data</span>
              <span class="time">20 min</span>
            </div>
            <a href="/diagnostics/ecu-hud-hacker-live-data-guide" class="read-more">Read Guide</a>
          </article>

          <article class="guide-card" data-category="fuel" data-engine="gy6" data-fuel="carb">
            <div class="card-guide-tag">GY6</div>
            <h3><a href="/diagnostics/gy6-carburetor-pilot-idle-jet.html">Carburetor Pilot &amp; Idle Jet — Diagnosis &amp; Cleaning</a></h3>
            <p>The blocked pilot jet is the number one cause of idle failure on carbureted GY6 scooters. How to identify, remove, clean, and adjust the pilot circuit.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">Carburetor</span>
              <span class="guide-guide-tag">Idle</span>
              <span class="guide-guide-tag">Pilot Jet</span>
              <span class="time">45 min</span>
            </div>
            <a href="/diagnostics/gy6-carburetor-pilot-idle-jet.html" class="read-more">Read Guide</a>
          </article>

          <article class="guide-card" data-category="fuel" data-engine="both" data-fuel="both">
            <div class="card-guide-tag">GY6 · Piaggio</div>
            <h3><a href="/diagnostics/gy6-air-leak-diagnosis.html">Air Leak &amp; Vacuum Sucking — Diagnosis</a></h3>
            <p>Unmetered air entering the intake causes erratic idle, lean running, and hard starts. How to locate and fix air leaks using the carb cleaner spray test.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">Carburetor</span>
              <span class="guide-guide-tag">EFI</span>
              <span class="guide-guide-tag">Air Leak</span>
              <span class="time">20 min</span>
            </div>
            <a href="/diagnostics/gy6-air-leak-diagnosis.html" class="read-more">Read Guide</a>
          </article>
        </div>

        <div class="section-label">Transmission &amp; Noise</div>
        <div class="guides-grid">
          <article class="guide-card" data-category="transmission" data-engine="both" data-fuel="both">
            <div class="card-guide-tag">GY6 · Piaggio</div>
            <h3><a href="/diagnostics/gy6-cvt-roller-noise-diagnosis.html">Metallic Noise from Engine — CVT Roller Diagnosis</a></h3>
            <p>Metallic rattling from the CVT cover at low to mid throttle is the classic sign of worn variator rollers. How to confirm, inspect, and replace them.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">CVT</span>
              <span class="guide-guide-tag">Variator</span>
              <span class="guide-guide-tag">Noise</span>
              <span class="time">25 min</span>
            </div>
            <a href="/diagnostics/gy6-cvt-roller-noise-diagnosis.html" class="read-more">Read Guide</a>
          </article>
        </div>

        <div class="section-label">Piaggio &amp; Gilera — Electrical Fault Finding</div>
        <div class="guides-grid">
          <article class="guide-card" data-category="electrical" data-engine="piaggio" data-fuel="both">
            <div class="card-guide-tag">Piaggio · Gilera · 2-Stroke</div>
            <h3><a href="/diagnostics/piaggio-gilera-2stroke-cdi-ignition-fault-finding.html">Piaggio &amp; Gilera 2-Stroke CDI Ignition Fault Finding</a></h3>
            <p>Systematic multimeter-based guide to diagnosing no-spark on Piaggio and Gilera 2-stroke 50cc scooters: pickup coil, CDI earth, stator power coil, and CDI unit testing with resistance and voltage values.</p>
            <div class="card-meta">
              <span class="card-meta-item">📅 2026-05-15</span>
              <span class="card-meta-item">⏱ 30–60 min</span>
              <span class="card-meta-item">🔧 Intermediate</span>
            </div>
            <a href="/diagnostics/piaggio-gilera-2stroke-cdi-ignition-fault-finding.html" class="read-more">Read Guide</a>
          </article>

          <article class="guide-card" data-category="electrical" data-engine="piaggio" data-fuel="both">
            <div class="card-guide-tag">Piaggio · Gilera · 2-Stroke</div>
            <h3><a href="/diagnostics/piaggio-gilera-starter-motor-fault-finding.html">Piaggio &amp; Gilera Starter Motor Fault Finding</a></h3>
            <p>Step-by-step fault-finding for the high-current and low-current starter circuits: relay bypass testing, battery diagnosis, brake interlock verification, and starter button trace.</p>
            <div class="card-meta">
              <span class="card-meta-item">📅 2026-05-15</span>
              <span class="card-meta-item">⏱ 30–60 min</span>
              <span class="card-meta-item">🔧 Intermediate</span>
            </div>
            <a href="/diagnostics/piaggio-gilera-starter-motor-fault-finding.html" class="read-more">Read Guide</a>
          </article>
        </div>

        <div class="no-results" id="noResults">No guides match these filters — try a different combination.</div>
      </div>
    </section>

    <script is:inline>
      function initializeFilters() {
        const cards = document.querySelectorAll('.guide-card');
        const countEl = document.getElementById('visibleCount');
        const noResults = document.getElementById('noResults');
        const searchInput = document.getElementById('diagSearch');
        const active = { category: 'all', engine: 'all', fuel: 'all' };

        function applyFilters() {
          const term = searchInput.value.trim().toLowerCase();
          let visible = 0;
          cards.forEach(card => {
            const cat  = card.getAttribute('data-category') || '';
            const eng  = card.getAttribute('data-engine')   || 'both';
            const fuel = card.getAttribute('data-fuel')     || 'both';
            const categoryMatch = active.category === 'all' || cat === active.category;
            const engineMatch   = active.engine === 'all'   || eng === active.engine  || eng === 'both';
            const fuelMatch     = active.fuel === 'all'     || fuel === active.fuel    || fuel === 'both';
            let textMatch = true;
            if (term) {
              const haystack = [
                card.querySelector('h3')?.textContent,
                card.querySelector('p')?.textContent,
                card.querySelector('.card-guide-tag')?.textContent,
              ].filter(Boolean).join(' ').toLowerCase();
              textMatch = haystack.includes(term);
            }
            const show = categoryMatch && engineMatch && fuelMatch && textMatch;
            card.classList.toggle('hidden', !show);
            if (show) visible++;
          });
          countEl.textContent = visible;
          noResults.classList.toggle('visible', visible === 0);
        }

        document.querySelectorAll('.filter-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const type  = btn.getAttribute('data-filter-type');
            const value = btn.getAttribute('data-filter');
            if (active[type] === value) {
              active[type] = 'all';
              btn.classList.remove('active');
            } else {
              document.querySelectorAll(`.filter-btn[data-filter-type="${type}"]`).forEach(b => b.classList.remove('active'));
              active[type] = value;
              btn.classList.add('active');
            }
            applyFilters();
          });
        });

        searchInput.addEventListener('input', applyFilters);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeFilters);
      } else {
        initializeFilters();
      }
    </script>
  </main>

  <footer data-pagefind-ignore class="guide-footer">
