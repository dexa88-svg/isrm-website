---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';

const title = "Videos — ISMR";
const description = "Curated repair and maintenance video guides for GY6 and Piaggio/Vespa scooters, with annotations and step-by-step companion text.";
const canonical = "https://ismr.online/videos/";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Videos — ISMR",
  "description": description,
  "url": canonical,
  "isPartOf": { "@type": "WebSite", "name": "ISMR", "url": "https://ismr.online/" }
};
---

<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <style is:global>
    .page-hero { background: linear-gradient(135deg, var(--bg-dark) 0%, var(--surface) 60%, var(--bg-dark) 100%); padding: 4rem 2rem 3rem; position: relative; overflow: hidden; border-bottom: 1px solid var(--border); }
    .page-hero::before { content: "📹"; position: absolute; right: 6%; top: 50%; transform: translateY(-50%); font-size: 9rem; opacity: 0.07; pointer-events: none; line-height: 1; }
    .page-hero-inner { max-width: 1100px; margin: 0 auto; }
    .page-hero h1 { font-size: clamp(2rem, 5vw, 3.2rem); background: linear-gradient(135deg, var(--text-primary), var(--accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 0.75rem; }
    .page-hero p { color: var(--text-secondary); font-size: 1.05rem; max-width: 620px; margin-bottom: 1.5rem; }
    .page-hero-stats { display: flex; gap: 2rem; flex-wrap: wrap; }
    .hero-stat { display: flex; flex-direction: column; gap: 0.15rem; }
    .hero-stat-number { font-size: 1.6rem; font-weight: 700; color: var(--primary); line-height: 1; }
    .hero-stat-label { font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
    .guides-section { padding: 3rem 2rem 5rem; }
    .guides-section-inner { max-width: 1100px; margin: 0 auto; }
    .guides-count { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1.5rem; }
    .guides-count strong { color: var(--text-primary); }
    .video-thumb { background: linear-gradient(135deg, var(--surface), var(--bg-dark)); border-radius: var(--radius-md); height: 130px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; position: relative; overflow: hidden; border: 1px solid var(--border); }
    .video-thumb::after { content: "▶"; font-size: 2rem; color: rgba(255,255,255,0.6); background: rgba(0,0,0,0.5); width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; padding-left: 4px; }
    .video-thumb-label { position: absolute; bottom: 0.5rem; left: 0.75rem; background: var(--primary); color: var(--bg-light); font-size: 0.7rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: var(--radius-sm); text-transform: uppercase; }
    .guide-card:hover .video-thumb { border-color: var(--primary); transition: var(--transition); }
    @media (max-width: 768px) {
      .page-hero { padding: 2.5rem 1rem 2rem; }
      .page-hero h1 { font-size: 1.8rem; }
      .page-hero-stats { gap: 1.2rem; }
      .guides-section { padding: 2rem 1rem 3rem; }
    }
    @media (max-width: 480px) {
      .page-hero h1 { font-size: 1.4rem; }
      .page-hero { padding: 2rem 1rem 1.5rem; }
      .hero-stat-number { font-size: 1.2rem; }
      .video-thumb { height: 100px; }
    }
  </style>

  <Navbar />

  <main data-pagefind-body role="main">
    <section class="page-hero">
      <div class="page-hero-inner">
        <div class="breadcrumb" style="padding: 0 0 1rem; margin: 0;">
          <a href="/">ISMR Home</a><span>›</span>Videos
        </div>
        <h1>Video Tutorials</h1>
        <p>Curated YouTube repair tutorials with structured summaries for GY6 and Piaggio/Vespa scooters. Each video is verified and summarised for quick reference.</p>
        <div class="page-hero-stats">
          <div class="hero-stat"><span class="hero-stat-number">5</span><span class="hero-stat-label">Tutorials</span></div>
          <div class="hero-stat"><span class="hero-stat-number">YouTube</span><span class="hero-stat-label">Source</span></div>
          <div class="hero-stat"><span class="hero-stat-number">Free</span><span class="hero-stat-label">Always</span></div>
        </div>
      </div>
    </section>

    <section class="guides-section">
      <div class="guides-section-inner">
        <p class="guides-count"><strong>5</strong> video tutorials</p>
        <div class="guides-grid">

          <article class="guide-card">
            <div class="video-thumb">
              <span class="video-thumb-label">YouTube</span>
            </div>
            <div class="card-guide-tag">GY6 · 150cc</div>
            <h3><a href="/videos/gy6-carburetor-intake-change-tutorial.html">Carburetor &amp; Intake Change Tutorial</a></h3>
            <p>Complete carburetor and intake manifold replacement on a GY6 157QMJ 150cc scooter — applicable to BTC Riva, Santini Capri, La Souris, and similar models.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">157QMJ</span>
              <span class="guide-guide-tag">Carburetor</span>
              <span class="time">Full tutorial</span>
            </div>
            <a href="/videos/gy6-carburetor-intake-change-tutorial.html" class="read-more">Watch &amp; Read</a>
          </article>

          <article class="guide-card">
            <div class="video-thumb">
              <span class="video-thumb-label">YouTube</span>
            </div>
            <div class="card-guide-tag">Vespa · Piaggio</div>
            <h3><a href="/videos/vespa-primavera-oil-change-video.html">DIY Vespa Oil Change — Primavera / GTS / Sprint</a></h3>
            <p>Step-by-step oil change for the Piaggio iGet engine. Covers drain plug torque, correct oil spec (5W-40 JASO MA2), fill volume, dipstick check, and service light reset.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">Primavera</span>
              <span class="guide-guide-tag">Sprint</span>
              <span class="time">20 min</span>
            </div>
            <a href="/videos/vespa-primavera-oil-change-video.html" class="read-more">Watch &amp; Read</a>
          </article>

          <article class="guide-card">
            <div class="video-thumb">
              <span class="video-thumb-label">YouTube</span>
            </div>
            <div class="card-guide-tag">Vespa · 50cc 4T</div>
            <h3><a href="/videos/vespa-carb-idle-adjustment-video.html">Basic Carb Adjustments for Carbureted Vespa Scooters</a></h3>
            <p>Idle speed screw, mixture screw, and throttle cable setup for Dell'Orto PHBN carbureted Vespa/Piaggio 50cc 4T scooters — embedded video with structured guide.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">Dell'Orto PHBN</span>
              <span class="guide-guide-tag">Carburettor</span>
              <span class="time">15 min</span>
            </div>
            <a href="/videos/vespa-carb-idle-adjustment-video.html" class="read-more">Watch &amp; Read</a>
          </article>

          <article class="guide-card">
            <div class="video-thumb"></div>
            <h3><a href="/videos/vespa-primavera-belt-transmission-video.html">Vespa Primavera &amp; Sprint — Belt and Transmission Assembly</a></h3>
            <p>Complete belt and driven pulley reassembly walkthrough for the Vespa Primavera 125/150 and Sprint 125/150 (i-Get engine family) — torque specs, belt wear identification, and tool list included.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">Piaggio</span>
              <span class="guide-guide-tag">Vespa Primavera</span>
              <span class="guide-guide-tag">CVT</span>
              <span class="time">35 min</span>
            </div>
            <a href="/videos/vespa-primavera-belt-transmission-video.html" class="read-more">Watch &amp; Read</a>
          </article>

          <article class="guide-card">
            <div class="video-thumb"></div>
            <h3><a href="/videos/vespa-piaggio-advanced-clutch-repair-video.html">Advanced Vespa/Piaggio Transmission Clutch &amp; Driven Pulley Repair</a></h3>
            <p>Advanced disassembly of the Vespa/Piaggio driven pulley — contra spring removal, clutch shoe inspection and measurement, and reassembly with correct preload. Covers GTS, Primavera, Sprint, LX, Liberty, Zip, and Fly.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">Piaggio</span>
              <span class="guide-guide-tag">Vespa</span>
              <span class="guide-guide-tag">Advanced</span>
              <span class="time">60 min</span>
            </div>
            <a href="/videos/vespa-piaggio-advanced-clutch-repair-video.html" class="read-more">Watch &amp; Read</a>
          </article>

        </div>
      </div>
    </section>
  </main>

  <footer data-pagefind-ignore class="guide-footer">
    <p>ISMR — Interactive Scooter Manuals for Repair. Content for educational purposes. CC BY-SA 4.0.</p>
    <p style="margin-top: 1rem;"><a href="/" style="color: var(--accent);">⚙️ ISMR Home</a></p>
    <p style="margin-top:0.75rem;font-size:0.82rem;color:var(--text-secondary);"><a href="/legal/privacy.html" style="color:var(--accent);">Privacy Policy</a> &nbsp;·&nbsp; <a href="/legal/terms.html" style="color:var(--accent);">Terms of Service</a></p>
  </footer>
</Base>
