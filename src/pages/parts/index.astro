  function runFinder() {
    const vehicle  = document.getElementById('fVehicle').value;
    const category = document.getElementById('fCategory').value;
    const query    = document.getElementById('fSearch').value.trim().toLowerCase();
    const resultsEl = document.getElementById('finderResults');
    const headerEl  = document.getElementById('finderHeader');
    const bodyEl    = document.getElementById('finderBody');

    bodyEl.innerHTML = '';

    if (!vehicle && !query) {
      bodyEl.innerHTML = '<div class="result-no-match">Please select a vehicle or type a part name to search.</div>';
      resultsEl.classList.add('active');
      return;
    }

    let results = [];
    if (vehicle && PARTS_DB[vehicle]) {
      const vehicleData = PARTS_DB[vehicle];
      if (category && vehicleData[category]) {
        results = vehicleData[category];
      } else {
        Object.values(vehicleData).forEach(arr => results.push(...arr));
      }
    } else if (!vehicle) {
      Object.values(PARTS_DB).forEach(vd => Object.values(vd).forEach(arr => results.push(...arr)));
    }

    if (query) {
      results = results.filter(p => p.name.toLowerCase().includes(query) || (p.pn && p.pn.toLowerCase().includes(query)));
    }

    const seen = new Set();
    results = results.filter(p => {
      const key = p.name + p.pn;
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    });

    const vehicleLabel = document.getElementById('fVehicle').selectedOptions[0]?.text || 'All vehicles';
    const catLabel     = category ? document.getElementById('fCategory').selectedOptions[0]?.text : 'All categories';
    headerEl.textContent = `Results for: ${vehicleLabel} — ${catLabel}${query ? ' · "' + query + '"' : ''} (${results.length} parts)`;

    if (results.length === 0) {
      bodyEl.innerHTML = '<div class="result-no-match">No parts found. Try a different vehicle, category, or search term.</div>';
    } else {
      results.forEach(p => {
        const badgeClass = p.compat === 'ok' ? 'result-compat-ok' : 'result-compat-warn';
        const badgeText  = p.compat === 'ok' ? '✓ Compatible' : '⚠ Verify';
        bodyEl.innerHTML += `<div class="finder-result-item"><div><div class="result-part-name">${p.name}</div><div class="result-part-number">${p.pn}</div><div class="result-part-spec">${p.spec}</div></div><span class="result-compat-badge ${badgeClass}">${badgeText}</span></div>`;
      });
    }

    resultsEl.classList.add('active');
    resultsEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  document.getElementById('fSearch').addEventListener('keydown', e => {
    if (e.key === 'Enter') runFinder();
  });

  function filterTables(query) {
    query = query.toLowerCase();
    document.querySelectorAll('.parts-table tbody tr').forEach(row => {
      row.classList.toggle('hidden-row', query !== '' && !row.textContent.toLowerCase().includes(query));
    });
  }

  function highlightVehicle(colIndex) {
    document.querySelectorAll('.parts-table').forEach(tbl => {
      const ths = tbl.querySelectorAll('thead th');
      const tds = tbl.querySelectorAll('tbody tr');
      ths.forEach(th => th.style.background = '');
      tds.forEach(row => row.querySelectorAll('td').forEach(td => td.style.background = ''));
      if (colIndex === '') return;
      const col = parseInt(colIndex) + 1;
      if (ths[col]) ths[col].style.background = 'rgba(255,107,53,0.18)';
      tds.forEach(row => {
        const td = row.querySelectorAll('td')[col];
        if (td) td.style.background = 'rgba(255,107,53,0.09)';
      });
    });
  }
