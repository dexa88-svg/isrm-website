---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';

const title = "Parts & Compatibility — ISMR";
const description = "Parts compatibility and cross-reference tables for GY6, Vespa LX/GTS, Primavera 125, and Piaggio Zip scooters — tyres, batteries, spark plugs, belts, and consumables.";
const canonical = "https://ismr.online/parts/";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Parts & Compatibility — ISMR",
  "description": description,
  "url": canonical,
  "isPartOf": { "@type": "WebSite", "name": "ISMR", "url": "https://ismr.online/" }
};
---

<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <style is:global>
    .page-hero { background: linear-gradient(135deg, var(--bg-dark) 0%, var(--surface) 60%, var(--bg-dark) 100%); padding: 4rem 2rem 3rem; position: relative; overflow: hidden; border-bottom: 1px solid var(--border); }
    .page-hero::before { content: "🔩"; position: absolute; right: 6%; top: 50%; transform: translateY(-50%); font-size: 9rem; opacity: 0.07; pointer-events: none; }
    .page-hero-inner { max-width: 1100px; margin: 0 auto; }
    .page-hero h1 { font-size: clamp(2rem, 5vw, 3.2rem); background: linear-gradient(135deg, var(--text-primary), var(--accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 0.75rem; }
    .page-hero p { color: var(--text-secondary); font-size: 1.05rem; max-width: 640px; margin-bottom: 1.5rem; }
    .page-hero-stats { display: flex; gap: 2rem; flex-wrap: wrap; }
    .hero-stat { display: flex; flex-direction: column; gap: 0.15rem; }
    .hero-stat-number { font-size: 1.6rem; font-weight: 700; color: var(--primary); line-height: 1; }
    .hero-stat-label { font-size: 0.78rem; color: var(--text-muted, var(--text-secondary)); text-transform: uppercase; letter-spacing: 0.05em; }
    .part-finder { background: linear-gradient(135deg, rgba(255,107,53,0.08), rgba(0,168,204,0.08)); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 2rem 2rem 1.5rem; margin-bottom: 3rem; }
    .part-finder h2 { font-size: 1.4rem; color: var(--text-primary); margin-bottom: 0.3rem; display: flex; align-items: center; gap: 0.5rem; }
    .part-finder > p { font-size: 0.95rem; margin-bottom: 1.5rem; }
    .finder-controls { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.25rem; }
    .finder-controls select, .finder-controls input { padding: 0.85rem 1.1rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); color: var(--text-primary); font-size: 0.95rem; width: 100%; }
    .finder-controls select:focus, .finder-controls input:focus { outline: none; border-color: var(--primary); }
    .finder-btn { padding: 0.85rem 2rem; background: var(--primary); border: none; border-radius: var(--radius-md); color: var(--bg-light); font-size: 0.95rem; font-weight: 600; cursor: pointer; transition: var(--transition); }
    .finder-btn:hover { background: var(--primary-dark); }
    .finder-results { display: none; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; margin-top: 1rem; }
    .finder-results.active { display: block; }
    .finder-result-header { padding: 0.9rem 1.5rem; background: linear-gradient(135deg, rgba(255,107,53,0.12), rgba(0,168,204,0.12)); border-bottom: 1px solid var(--border); font-weight: 600; font-size: 0.9rem; color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em; }
    .finder-result-item { display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: start; padding: 1rem 1.5rem; border-bottom: 1px solid var(--border); }
    .finder-result-item:last-child { border-bottom: none; }
    .finder-result-item:hover { background: var(--surface-2); }
    .result-part-name { font-weight: 600; color: var(--text-primary); margin-bottom: 0.2rem; }
    .result-part-number { font-size: 0.85rem; color: var(--accent); }
    .result-part-spec { font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.2rem; }
    .result-compat-badge { padding: 0.3rem 0.7rem; border-radius: var(--radius-sm); font-size: 0.78rem; font-weight: 600; text-transform: uppercase; white-space: nowrap; }
    .result-compat-ok  { background: rgba(6,167,125,0.2); color: var(--success); }
    .result-compat-warn{ background: rgba(245,166,35,0.2); color: var(--warning); }
    .result-no-match   { padding: 1.5rem; text-align: center; color: var(--text-secondary); }
    .parts-controls { display: flex; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap; }
    .parts-controls input, .parts-controls select { padding: 0.8rem 1.2rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); color: var(--text-primary); font-size: 0.95rem; }
    .parts-controls input:focus, .parts-controls select:focus { outline: none; border-color: var(--primary); }
    .section-heading { display: flex; align-items: center; gap: 0.75rem; margin: 3.5rem 0 1.25rem; }
    .section-heading h2 { font-size: 1.5rem; color: var(--text-primary); margin: 0; }
    .section-heading-icon { width: 2.2rem; height: 2.2rem; background: linear-gradient(135deg, var(--primary), var(--accent)); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; }
    .parts-table { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 0.5rem; font-size: 0.92rem; }
    .parts-table thead { background: linear-gradient(135deg, rgba(255,107,53,0.1), rgba(0,164,204,0.1)); border-bottom: 2px solid var(--border); }
    .parts-table th { padding: 0.9rem 1.1rem; text-align: left; font-weight: 600; color: var(--accent); text-transform: uppercase; font-size: 0.78rem; letter-spacing: 0.5px; white-space: nowrap; }
    .parts-table td { padding: 0.85rem 1.1rem; border-bottom: 1px solid var(--border); color: var(--text-secondary); vertical-align: top; }
    .parts-table tr:hover { background: var(--surface-2); }
    .parts-table tr:last-child td { border-bottom: none; }
    .parts-table tr.hidden-row { display: none; }
    .part-name { font-weight: 600; color: var(--text-primary); }
    .part-num  { font-size: 0.82rem; color: var(--accent); display: block; margin-top: 0.15rem; }
    .part-note { font-size: 0.8rem; color: var(--text-secondary); }
    .cb { display: inline-block; padding: 0.32rem 0.7rem; border-radius: var(--radius-sm); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; white-space: nowrap; }
    .cb-yes  { background: rgba(6,167,125,0.18); color: var(--success); }
    .cb-part { background: rgba(245,166,35,0.18); color: var(--warning); }
    .cb-no   { background: rgba(214,48,49,0.18); color: var(--danger); }
    .pn { display: block; margin-top: 0.25rem; font-size: 0.78rem; color: var(--accent); opacity: 0.85; }
    .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1rem; margin-top: 3rem; }
    .cat-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem; text-align: center; transition: var(--transition); cursor: pointer; display: block; text-decoration: none; color: inherit; }
    .cat-card:hover { border-color: var(--primary); transform: translateY(-3px); box-shadow: var(--shadow-sm); }
    .cat-card-icon { font-size: 2.2rem; margin-bottom: 0.75rem; }
    .cat-card h3 { font-size: 1rem; color: var(--text-primary); margin: 0 0 0.3rem; }
    .cat-card p  { font-size: 0.8rem; color: var(--text-secondary); margin: 0; }
    .tip { background: rgba(245,166,35,0.08); border-left: 3px solid var(--warning); border-radius: 0 var(--radius-md) var(--radius-md) 0; padding: 0.85rem 1.2rem; font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 1rem; }
    .tip strong { color: var(--warning); }
    .callout { padding: 1rem 1.25rem; border-radius: 0 var(--radius-md) var(--radius-md) 0; margin: 1.5rem 0; font-size: 0.95rem; color: var(--text-secondary); }
    .callout strong { color: var(--text-primary); }
    .callout-tip { background: rgba(6,167,125,0.08); border: 1px solid rgba(6,167,125,0.25); border-left: 4px solid var(--success); }
    @media (max-width: 900px) { .parts-table { font-size: 0.83rem; } .parts-table th, .parts-table td { padding: 0.65rem 0.6rem; } }
    @media (max-width: 600px) { .parts-controls { flex-direction: column; } .parts-controls input, .parts-controls select { width: 100%; } .finder-controls { grid-template-columns: 1fr; } }
    @media (max-width: 768px) { .page-hero { padding: 2.5rem 1rem 2rem; } .page-hero h1 { font-size: 1.8rem; } .page-hero-stats { gap: 1.2rem; } }
    @media (max-width: 480px) { .page-hero h1 { font-size: 1.4rem; } .page-hero { padding: 2rem 1rem 1.5rem; } }
  </style>

  <Navbar activePage="parts" />

  <section class="page-hero">
    <div class="page-hero-inner">
      <div class="breadcrumb" style="padding:0 0 1rem;margin:0;">
        <a href="/">ISMR Home</a><span>›</span>Parts &amp; Compatibility
      </div>
      <h1>Parts &amp; Compatibility</h1>
      <p>Exact part numbers, specifications, and cross-compatibility data for GY6, Piaggio Vespa, Primavera, and Zip scooters — carburetor and injection variants.</p>
      <div class="page-hero-stats">
        <div class="hero-stat"><span class="hero-stat-number">4</span><span class="hero-stat-label">Platforms</span></div>
        <div class="hero-stat"><span class="hero-stat-number">7</span><span class="hero-stat-label">Categories</span></div>
        <div class="hero-stat"><span class="hero-stat-number">80+</span><span class="hero-stat-label">Parts Listed</span></div>
        <div class="hero-stat"><span class="hero-stat-number">Free</span><span class="hero-stat-label">Always</span></div>
      </div>
    </div>
  </section>

  <main data-pagefind-body class="container" style="padding-top:2.5rem;padding-bottom:5rem;">

    <div class="part-finder" id="partFinder">
      <h2>🔍 Part Finder</h2>
      <p>Select your scooter and the part you need — we'll show you the exact specification and part number.</p>
      <div class="finder-controls">
        <select id="fVehicle">
          <option value="">① Select vehicle</option>
          <optgroup label="GY6 Platform">
            <option value="gy6-50">GY6 50cc (139QMB) — BTC Riva, Sourini City…</option>
            <option value="gy6-125">GY6 125cc (152QMI) — Santini Capri, generic</option>
            <option value="gy6-150">GY6 150cc (157QMJ) — generic 150</option>
          </optgroup>
          <optgroup label="Piaggio / Vespa">
            <option value="vespa">Piaggio Vespa (GTS, LX, S — all 125/150)</option>
            <option value="primavera">Piaggio Primavera 125 (i.e. 3V)</option>
            <option value="zip50">Piaggio Zip 50 (2-stroke)</option>
            <option value="zip125">Piaggio Zip 125 (4-stroke)</option>
          </optgroup>
        </select>
        <select id="fCategory">
          <option value="">② Select category</option>
          <option value="engine">Engine</option>
          <option value="transmission">Transmission / CVT</option>
          <option value="brakes">Brakes</option>
          <option value="tyres">Tyres &amp; Wheels</option>
          <option value="electrical">Electrical</option>
          <option value="fluids">Fluids &amp; Filters</option>
          <option value="chassis">Chassis &amp; Suspension</option>
        </select>
        <input type="text" id="fSearch" placeholder="③ Or type a part name…" />
        <button class="finder-btn" onclick="runFinder()">Find Part</button>
      </div>
      <div class="finder-results" id="finderResults">
        <div class="finder-result-header" id="finderHeader">Results</div>
        <div id="finderBody"></div>
      </div>
    </div>

    <div class="parts-controls">
      <input type="text" placeholder="Filter all tables below…" id="globalSearch" style="flex:1;" oninput="filterTables(this.value)" />
      <select id="vehicleHighlight" onchange="highlightVehicle(this.value)" style="min-width:200px;">
        <option value="">Highlight vehicle…</option>
        <option value="0">GY6 50cc</option>
        <option value="1">GY6 125/150cc</option>
        <option value="2">Piaggio Vespa</option>
        <option value="3">Piaggio Primavera</option>
        <option value="4">Piaggio Zip</option>
      </select>
    </div>

    <!-- ENGINE -->
    <div class="section-heading" id="sec-engine">
      <div class="section-heading-icon">🔧</div>
      <h2>Engine Parts</h2>
    </div>
    <div class="callout callout-tip"><strong>Column guide:</strong> Part numbers shown are OEM or widely-accepted aftermarket references. Always verify against your engine code stamped on the case.</div>
    <table class="parts-table" data-section="engine">
      <thead>
        <tr>
          <th>Part</th>
          <th>GY6 50cc<br><small>139QMB</small></th>
          <th>GY6 125/150cc<br><small>152QMI / 157QMJ</small></th>
          <th>Piaggio Vespa<br><small>125/150 4T</small></th>
          <th>Piaggio Primavera<br><small>125 i.e. 3V</small></th>
          <th>Piaggio Zip<br><small>50 2T / 125 4T</small></th>
          <th>Notes</th>
        </tr>
      </thead>
      <tbody>
        <tr><td><span class="part-name">Spark Plug</span></td><td><span class="cb cb-yes">✓ Compatible</span><span class="pn">NGK CR7HSA</span><span class="pn">Gap: 0.6–0.7 mm</span></td><td><span class="cb cb-yes">✓ Compatible</span><span class="pn">NGK CR8E / DR8EA</span><span class="pn">Gap: 0.6–0.7 mm</span></td><td><span class="cb cb-part">Model-specific</span><span class="pn">NGK CR8EIX (GTS)</span><span class="pn">Gap: 0.8–0.9 mm</span></td><td><span class="cb cb-part">Model-specific</span><span class="pn">NGK CR8EIX</span><span class="pn">Gap: 0.7 mm</span></td><td><span class="cb cb-part">2T: NGK BR8ES</span><span class="pn">4T: NGK C7HSA</span><span class="pn">Gap: 0.5–0.6 mm</span></td><td class="part-note">Re-gap every plug before fitting. Replace every 6,000 km or annually.</td></tr>
        <tr><td><span class="part-name">Air Filter</span></td><td><span class="cb cb-yes">✓ Universal</span><span class="pn">38 mm pod filter or OEM foam</span></td><td><span class="cb cb-yes">✓ Universal</span><span class="pn">42/45 mm pod or OEM foam</span></td><td><span class="cb cb-no">✗ Model-specific</span><span class="pn">Piaggio OEM cartridge</span><span class="pn">⚠ Verify current P/N via Piaggio dealer</span></td><td><span class="cb cb-no">✗ Model-specific</span><span class="pn">Piaggio OEM cartridge</span></td><td><span class="cb cb-no">✗ Different</span><span class="pn">Zip 50 2T: foam sponge</span><span class="pn">Zip 100/125 4T: Piaggio OEM</span></td><td class="part-note">GY6: inspect every 3,000 km. Piaggio Vespa/Primavera: dry paper cartridge, replace every 12,000 km.</td></tr>
        <tr><td><span class="part-name">Oil Filter</span></td><td><span class="cb cb-yes">✓ Compatible</span><span class="pn">Hiflofiltro HF556</span></td><td><span class="cb cb-yes">✓ Compatible</span><span class="pn">Hiflofiltro HF556 or Mann MO 65</span></td><td><span class="cb cb-part">Check variant</span><span class="pn">GTS 125: no spin-off (centrifugal filter)</span></td><td><span class="cb cb-no">✗ Centrifugal</span><span class="pn">No replaceable filter</span></td><td><span class="cb cb-no">✗ 2T: no filter</span><span class="pn">Zip 100 4T: mesh screen</span></td><td class="part-note">GY6: change at every oil service. Piaggio i.e.: centrifugal oil cleaning.</td></tr>
        <tr><td><span class="part-name">Engine Oil</span></td><td><span class="cb cb-yes">✓ Standard</span><span class="pn">10W-40 semi-synth 4T</span><span class="pn">Capacity: 0.8 L</span></td><td><span class="cb cb-yes">✓ Standard</span><span class="pn">10W-40 semi-synth 4T</span><span class="pn">Capacity: 1.1 L</span></td><td><span class="cb cb-part">Brand-specific</span><span class="pn">5W-40 full-synth 4T</span><span class="pn">Capacity: 1.0 L</span></td><td><span class="cb cb-part">Brand-specific</span><span class="pn">5W-40 full-synth 4T</span><span class="pn">Capacity: 1.0 L</span></td><td><span class="cb cb-no">✗ 2T: Premix 2T oil</span><span class="pn">4T: 5W-40 synth, 0.8 L</span></td><td class="part-note">GY6: change every 2,000 km. Piaggio i.e.: 3,000 km or annually.</td></tr>
        <tr><td><span class="part-name">Piston Kit</span></td><td><span class="cb cb-yes">✓ Standard bore</span><span class="pn">Ø 39 mm (50cc)</span></td><td><span class="cb cb-yes">✓ Standard bore</span><span class="pn">Ø 52.4 mm (125cc) / Ø 57.4 mm (150cc)</span></td><td><span class="cb cb-no">✗ Proprietary</span><span class="pn">Piaggio OEM only</span></td><td><span class="cb cb-no">✗ Proprietary</span><span class="pn">Piaggio OEM only</span></td><td><span class="cb cb-no">✗ Proprietary</span><span class="pn">Polini/Malossi for Zip 50 2T</span></td><td class="part-note">Measure cylinder bore before ordering oversize.</td></tr>
        <tr><td><span class="part-name">Carburetor</span></td><td><span class="cb cb-yes">✓ Standard</span><span class="pn">PZ19 (50cc stock)</span></td><td><span class="cb cb-yes">✓ Standard</span><span class="pn">PZ22 / PZ24 (125/150cc)</span></td><td><span class="cb cb-no">N/A — EFI</span></td><td><span class="cb cb-no">N/A — EFI</span></td><td><span class="cb cb-yes">Zip 50 2T: SHA 14</span><span class="pn">Dellorto SHA 14.12</span></td><td class="part-note">Main jet size varies by altitude.</td></tr>
      </tbody>
    </table>

    <!-- TRANSMISSION -->
    <div class="section-heading" id="sec-transmission">
      <div class="section-heading-icon">⚙️</div>
      <h2>Transmission &amp; CVT</h2>
    </div>
    <table class="parts-table" data-section="transmission">
      <thead>
        <tr>
          <th>Part</th><th>GY6 50cc<br><small>139QMB</small></th><th>GY6 125/150cc<br><small>152QMI / 157QMJ</small></th><th>Piaggio Vespa<br><small>125/150 4T</small></th><th>Piaggio Primavera<br><small>125 i.e. 3V</small></th><th>Piaggio Zip<br><small>50 2T / 125 4T</small></th><th>Notes</th>
        </tr>
      </thead>
      <tbody>
        <tr><td><span class="part-name">CVT Drive Belt</span></td><td><span class="cb cb-yes">✓ Standard</span><span class="pn">669 × 18 × 30</span><span class="pn">Gates 6736 MC</span></td><td><span class="cb cb-yes">✓ Standard</span><span class="pn">743 × 20 × 30 (125cc)</span><span class="pn">788 × 20 × 30 (150cc)</span></td><td><span class="cb cb-no">✗ Proprietary</span><span class="pn">Piaggio 82700R</span></td><td><span class="cb cb-no">✗ Proprietary</span><span class="pn">Piaggio 82700R</span></td><td><span class="cb cb-no">✗ Different</span><span class="pn">Zip 50: Piaggio 433352</span></td><td class="part-note">Replace at first sign of cracking or every 15,000 km.</td></tr>
        <tr><td><span class="part-name">Variator Rollers</span></td><td><span class="cb cb-yes">✓ Standard</span><span class="pn">Ø 16 × 13 mm — 7.5–8.5 g</span></td><td><span class="cb cb-yes">✓ Standard</span><span class="pn">Ø 16 × 13 mm — 8–10 g</span><span class="pn">Dr Pulley SR 16×13</span></td><td><span class="cb cb-no">✗ Piaggio specific</span><span class="pn">Ø 23 × 18 mm — 15 g</span><span class="pn">Malossi 6618170</span></td><td><span class="cb cb-no">✗ Piaggio specific</span><span class="pn">Ø 23 × 18 mm</span></td><td><span class="cb cb-no">✗ Different</span><span class="pn">Zip 50: Ø 19 × 15.5 mm</span></td><td class="part-note">Heavier rollers = higher top speed. Replace if flat spots appear. Note: Zip 50 rollers are NOT interchangeable with GY6 50cc.</td></tr>
        <tr><td><span class="part-name">Clutch Shoes / Bell</span></td><td><span class="cb cb-yes">✓ Generic</span><span class="pn">3-shoe kit, 107 mm bell</span></td><td><span class="cb cb-yes">✓ Generic</span><span class="pn">3-shoe kit, 125 mm bell</span></td><td><span class="cb cb-no">✗ Proprietary</span><span class="pn">Piaggio / Polini kit</span></td><td><span class="cb cb-no">✗ Proprietary</span><span class="pn">Polini 241.004</span></td><td><span class="cb cb-no">✗ Proprietary</span><span class="pn">Polini / Malossi kits</span></td><td class="part-note">Replace at ≤2 mm. Clean bell with brake cleaner.</td></tr>
        <tr><td><span class="part-name">Gear / Transmission Oil</span></td><td><span class="cb cb-yes">✓ Standard</span><span class="pn">80W-90 — ~80–100 ml</span></td><td><span class="cb cb-yes">✓ Standard</span><span class="pn">80W-90 — ~100–120 ml</span></td><td><span class="cb cb-no">N/A — sealed unit</span></td><td><span class="cb cb-no">N/A — sealed unit</span></td><td><span class="cb cb-no">N/A — no gearbox oil</span></td><td class="part-note">GY6 final gearbox. Change every 10,000 km.</td></tr>
      </tbody>
    </table>

    <!-- BRAKES -->
    <div class="section-heading" id="sec-brakes">
      <div class="section-heading-icon">🛑</div>
      <h2>Brakes</h2>
    </div>
    <table class="parts-table" data-section="brakes">
      <thead>
        <tr><th>Part</th><th>GY6 50cc<br><small>139QMB</small></th><th>GY6 125/150cc<br><small>152QMI / 157QMJ</small></th><th>Piaggio Vespa<br><small>125/150 4T</small></th><th>Piaggio Primavera<br><small>125 i.e. 3V</small></th><th>Piaggio Zip<br><small>50 2T / 125 4T</small></th><th>Notes</th></tr>
      </thead>
      <tbody>
        <tr><td><span class="part-name">Front Brake Pads (disc)</span></td><td><span class="cb cb-part">Varies</span><span class="pn">Some: drum / Disc: Goldfren S33</span></td><td><span class="cb cb-yes">✓ Standard disc</span><span class="pn">EBC FA354 or Goldfren</span><span class="pn">Rotor: 220 mm typical</span></td><td><span class="cb cb-yes">✓ Disc</span><span class="pn">EBC FA174 / Ferodo FDB</span></td><td><span class="cb cb-yes">✓ Disc</span><span class="pn">EBC FA174 / Brembo OEM</span><span class="pn">Rotor: 200 mm</span></td><td><span class="cb cb-part">50: drum / 125: disc</span><span class="pn">125: EBC FA174</span></td><td class="part-note">Replace at ≤1.5 mm friction material.</td></tr>
