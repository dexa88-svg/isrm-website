---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';

const title = "Models — ISMR";
const description = "Overview of all scooter platforms covered by ISMR — GY6 50/125/150cc, Vespa LX/GTS, Primavera 125, and Piaggio Zip 50/125.";
const canonical = "https://ismr.online/models/";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Models — ISMR",
  "description": description,
  "url": canonical,
  "isPartOf": { "@type": "WebSite", "name": "ISMR", "url": "https://ismr.online/" }
};
---

<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <style is:global>
    .page-hero { background: linear-gradient(135deg, var(--bg-dark) 0%, var(--surface) 60%, var(--bg-dark) 100%); padding: 4rem 2rem 3rem; position: relative; overflow: hidden; border-bottom: 1px solid var(--border); }
    .page-hero::before { content: "🛵"; position: absolute; right: 6%; top: 50%; transform: translateY(-50%); font-size: 9rem; opacity: 0.07; pointer-events: none; line-height: 1; }
    .page-hero-inner { max-width: 1100px; margin: 0 auto; }
    .page-hero h1 { font-size: clamp(2rem, 5vw, 3.2rem); background: linear-gradient(135deg, var(--text-primary), var(--accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 0.75rem; }
    .page-hero p { color: var(--text-secondary); font-size: 1.05rem; max-width: 620px; margin-bottom: 1.5rem; }
    .page-hero-stats { display: flex; gap: 2rem; flex-wrap: wrap; }
    .hero-stat { display: flex; flex-direction: column; gap: 0.15rem; }
    .hero-stat-number { font-size: 1.6rem; font-weight: 700; color: var(--primary); line-height: 1; }
    .hero-stat-label { font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
    .guides-section { padding: 3rem 2rem 5rem; }
    .guides-section-inner { max-width: 1100px; margin: 0 auto; }
    .guides-count { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1.5rem; }
    .guides-count strong { color: var(--text-primary); }
    @media (max-width: 768px) {
      .page-hero { padding: 2.5rem 1rem 2rem; }
      .page-hero h1 { font-size: 1.8rem; }
      .page-hero-stats { gap: 1.2rem; }
      .guides-section { padding: 2rem 1rem 3rem; }
    }
    @media (max-width: 480px) {
      .page-hero h1 { font-size: 1.4rem; }
      .page-hero { padding: 2rem 1rem 1.5rem; }
      .hero-stat-number { font-size: 1.2rem; }
    }
  </style>

  <Navbar activePage="models" />

  <main data-pagefind-body role="main">
    <section class="page-hero">
      <div class="page-hero-inner">
        <div class="breadcrumb" style="padding: 0 0 1rem; margin: 0;">
          <a href="/index.html">ISMR Home</a><span>›</span>Models
        </div>
        <h1>Scooter Models</h1>
        <p>Model-specific technical overviews, maintenance schedules, common faults, and specs for GY6-platform and Piaggio/Vespa petrol scooters.</p>
        <div class="page-hero-stats">
          <div class="hero-stat"><span class="hero-stat-number">5</span><span class="hero-stat-label">Models</span></div>
          <div class="hero-stat"><span class="hero-stat-number">GY6 + Piaggio</span><span class="hero-stat-label">Platforms</span></div>
          <div class="hero-stat"><span class="hero-stat-number">Free</span><span class="hero-stat-label">Always</span></div>
        </div>
      </div>
    </section>

    <section class="guides-section">
      <div class="guides-section-inner">
        <p class="guides-count"><strong>5</strong> model overviews</p>
        <div class="guides-grid">

          <article class="guide-card">
            <div class="card-guide-tag">Piaggio · ZIP 50</div>
            <h3><a href="/models/vespa-zip-50-4t-technical-overview.html">Piaggio ZIP 50 4T — Technical Overview</a></h3>
            <p>Full specs, maintenance schedule, Dell'Orto PHBN carburettor settings, common faults, and model history for the Piaggio ZIP 50 4T (2001–present, carbureted variants).</p>
            <div class="card-meta">
              <span class="guide-guide-tag">Carburetor</span>
              <span class="guide-guide-tag">4-Stroke</span>
              <span class="time">Reference</span>
            </div>
            <a href="/models/vespa-zip-50-4t-technical-overview.html" class="read-more">View Model</a>
          </article>

          <article class="guide-card">
            <div class="card-guide-tag">Piaggio · ZIP</div>
            <h3><a href="/models/piaggio-zip-100-technical-overview.html">Piaggio ZIP 50/100 4T — Technical Overview</a></h3>
            <p>Full specs from the official Piaggio service manual: engine data, KEIHIN CVK 20 carburettor settings, torque table, maintenance schedule, lubricant specifications, and common faults.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">Carburetor</span>
              <span class="guide-guide-tag">CVT</span>
              <span class="time">Reference</span>
            </div>
            <a href="/models/piaggio-zip-100-technical-overview.html" class="read-more">View Model</a>
          </article>

          <article class="guide-card">
            <div class="card-guide-tag">Vespa · Piaggio</div>
            <h3><a href="/models/vespa-primavera-125-technical-overview.html">Vespa Primavera 125 — Technical Overview</a></h3>
            <p>Full specs, maintenance schedule, common faults, Euro 3/4/5 variants, and service manual resources for the Vespa Primavera 125 iGet engine.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">iGet</span>
              <span class="guide-guide-tag">Fuel Injection</span>
              <span class="time">Reference</span>
            </div>
            <a href="/models/vespa-primavera-125-technical-overview.html" class="read-more">View Model</a>
          </article>

          <article class="guide-card">
            <div class="card-guide-tag">GY6</div>
            <h3><a href="/models/la-souris-sourini-city-overview.html">La Souris Sourini / City S — Model Overview</a></h3>
            <p>Technical overview, specifications, and common repair information for the La Souris Sourini and City S GY6-platform scooters.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">Carburetor</span>
              <span class="guide-guide-tag">139QMB</span>
              <span class="time">Reference</span>
            </div>
            <a href="/models/la-souris-sourini-city-overview.html" class="read-more">View Model</a>
          </article>

          <article class="guide-card">
            <div class="card-guide-tag">GY6 · BTC</div>
            <h3><a href="/models/btc-riva-50-model-overview.html">BTC Riva 50 — Model Overview</a></h3>
            <p>Technical specifications, carburetor jetting, CVT data, valve clearances, routine maintenance schedule, and parts compatibility notes for the BTC Riva 50.</p>
            <div class="card-meta">
              <span class="guide-guide-tag">Carburetor</span>
              <span class="guide-guide-tag">139QMB</span>
              <span class="time">Reference</span>
            </div>
            <a href="/models/btc-riva-50-model-overview.html" class="read-more">View Model</a>
          </article>

        </div>
      </div>
    </section>
  </main>

  <footer data-pagefind-ignore class="guide-footer">
    <p>ISMR — Interactive Scooter Manuals for Repair. Content for educational purposes. CC BY-SA 4.0.</p>
    <p style="margin-top: 1rem;"><a href="/index.html" style="color: var(--accent);">⚙️ ISMR Home</a></p>
    <p style="margin-top:0.75rem;font-size:0.82rem;color:var(--text-secondary);"><a href="/legal/privacy.html" style="color:var(--accent);">Privacy Policy</a> &nbsp;·&nbsp; <a href="/legal/terms.html" style="color:var(--accent);">Terms of Service</a></p>
  </footer>
</Base>
