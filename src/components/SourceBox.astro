---
interface Source {
  name: string;
  url: string;
}
interface Props {
  sources: Source[];
}
const { sources } = Astro.props;
---

{sources && sources.length > 0 && (
  <div class="source-box">
    <strong>Sources:</strong>
    <ul>
      {sources.map(s => (
        <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a></li>
      ))}
    </ul>
  </div>
)}
