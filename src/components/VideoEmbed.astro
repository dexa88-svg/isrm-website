---
interface Props {
  videoId: string;
  title: string;
  creator?: string;
}
const { videoId, title, creator } = Astro.props;
---

<div class="video-embed">
  <div class="video-embed-title">🎬 {title}</div>
  <div class="video-container">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${videoId}`}
      title={title}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
  {creator && (
    <p class="video-source">
      <strong>Video:</strong> "{title}"{creator ? ` · ${creator}` : ''} &nbsp;
      <a href={`https://www.youtube.com/watch?v=${videoId}`} target="_blank" rel="noopener">↗ Watch on YouTube</a>
    </p>
  )}
</div>
