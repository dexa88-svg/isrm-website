RewriteEngine On

# NOTE: We do NOT force-redirect HTTP -> HTTPS here on the origin.
# Cloudflare sits in front in "Flexible" SSL mode (this Hetzner webhosting
# plan cannot install its own certificate), which means Cloudflare always
# connects to this origin over plain HTTP even when the visitor used HTTPS.
# A RewriteCond %{HTTPS} off check here is therefore ALWAYS true from the
# origin's point of view, so a redirect rule here creates a redirect loop
# (origin -> https://... -> Cloudflare -> http to origin -> repeat).
# HTTPS for visitors is enforced at the Cloudflare edge instead
# (SSL/TLS -> Edge Certificates -> "Always Use HTTPS"). Do not re-add an
# HTTPS redirect here unless the origin gets its own valid certificate and
# Cloudflare is switched to Full/Full (strict).

# Redirect www to non-www (canonical domain)
RewriteCond %{HTTP_HOST} ^www\.ismr\.online [NC]
RewriteRule ^ https://ismr.online%{REQUEST_URI} [L,R=301]

# 301 redirects: trailing-slash legal pages → canonical .html URLs
# Prevents Google from seeing duplicate "alternative page with proper canonical" entries
RewriteRule ^legal/privacy/?$ /legal/privacy.html [L,R=301]
RewriteRule ^legal/terms/?$ /legal/terms.html [L,R=301]

# 301 redirect: root index.html → / (canonical homepage URL)
# Prevents Google from seeing /index.html as a separate crawlable/indexable URL
RewriteRule ^index\.html$ / [L,R=301]

# Security headers — improves Microsoft SmartScreen / SafeLinks reputation
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Force HTTPS for 1 year (HSTS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Control referrer information
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions policy — disable unused browser features
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Content Security Policy — allow GA, YouTube embeds, Google Fonts
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://www.youtube-nocookie.com https://www.youtube.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com; object-src 'none'; base-uri 'self';"
</IfModule>
